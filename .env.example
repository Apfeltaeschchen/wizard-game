# Port für den Web- und WebSocket-Server
PORT=3000

# =======================================================
# DATENBANK-KONFIGURATION (DUAL-SUPPORT)
# =======================================================
# 1. PostgreSQL (Produktion, Docker oder Managed Cloud wie Supabase / Neon):
# Setze DATABASE_URL, um die vollwertige PostgreSQL-Client/Server-Datenbank zu aktivieren.
# DATABASE_URL=postgres://wizard:secret@localhost:5432/grimoire_db

# 2. SQLite (Standard / Lokaler Modus / Offline / Tests):
# Wird automatisch aktiv, wenn DATABASE_URL leer ist.
# WIZARD_DB_PATH=server/data/wizard.db

# Optional: SSL-Zertifikatsprüfung für Cloud-PostgreSQL (z. B. require)
# PGSSLMODE=require
